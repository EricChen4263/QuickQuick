# 依赖与构建产物
/node_modules
/dist
/src-tauri/target
tsconfig.tsbuildinfo
# pnpm 11 在本仓（存在 pnpm-workspace.yaml）默认把 store 建在项目内，不入库
/.pnpm-store
# 覆盖率报告（make coverage 的前端产物，只进 CI artifact，不入库；
# 后端报告落在已忽略的 /src-tauri/target 下）
/coverage
# 系统/编辑器
.DS_Store
*.log
# Tauri 签名私钥（绝不入库）
*.key
/src-tauri/gen
/.claude
# ECDICT 本地词库：真库由 CI 用 tools/gen_ecdict_db.py 生成（~数十MB），不入库；
# 源 CSV 同样不入库（CI 按固定 commit SHA 临时拉取）。
/src-tauri/resources/ecdict.db
/src-tauri/ecdict.csv
ecdict.csv
__pycache__/

# gh CLI 日志缓存（本地排查 CI 用）
.ghcache/
